{
  "name": "equiptrack-root",
  "version": "1.0.0",
  "description": "EquipTrack - School & Office Equipment Borrowing System",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev -- --host 0.0.0.0",
    "seed": "cd server && npm run seed",
    "start": "node server/src/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
